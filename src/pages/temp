// src/pages/Tickets.tsx
import {useEffect, useState, useMemo} from 'react';
import {
    Ticket as TicketIcon, Plus, Search, UserCog, Clock, CheckCircle, AlertCircle, X,
    Filter, ChevronRight, MessageSquare, FileText, Send, Link2, BookPlus,
    ArrowRight, Pause, Play, Archive, BarChart3, TrendingUp, Users as UsersIcon,
} from 'lucide-react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from 'recharts';
import {api, type Ticket, type TicketRecord, type Employee, type KbCategory} from '@/lib/api';
import {useAuth} from '@/context/AuthContext';


const statusConfig: Record<string, { label: string; color: string; icon: any }> = {
    pending: {label: '待受理', color: 'text-amber-400 bg-amber-500/10', icon: AlertCircle},
    in_progress: {label: '处理中', color: 'text-cyan-400 bg-cyan-500/10', icon: Clock},
    pending_review: {label: '待回访', color: 'text-blue-400 bg-blue-500/10', icon: UserCog},
    closed: {label: '已完结', color: 'text-emerald-400 bg-emerald-500/10', icon: CheckCircle},
    open: {label: '待受理', color: 'text-amber-400 bg-amber-500/10', icon: AlertCircle},
    assigned: {label: '处理中', color: 'text-cyan-400 bg-cyan-500/10', icon: Clock},
    resolved: {label: '待回访', color: 'text-blue-400 bg-blue-500/10', icon: UserCog},
};

const priorityConfig: Record<string, { label: string; color: string }> = {
    low: {label: '低', color: 'text-slate-400'},
    medium: {label: '中', color: 'text-blue-400'},
    high: {label: '高', color: 'text-amber-400'},
    urgent: {label: '紧急', color: 'text-red-400'},
};

const statusFlow = ['pending', 'in_progress', 'pending_review', 'closed'];

type TicketWithNames = Ticket & { creator_name?: string; assignee_name?: string };
type ViewMode = 'list' | 'stats';

export default function Tickets() {
    const {employee, isAdmin} = useAuth();
    const [tickets, setTickets] = useState<TicketWithNames[]>([]);
    const [employees, setEmployees] = useState<Employee[]>([]);
    const [categories, setCategories] = useState<KbCategory[]>([]);
    const [loading, setLoading] = useState(true);
    const [search, setSearch] = useState('');
    const [statusFilter, setStatusFilter] = useState('all');
    const [priorityFilter, setPriorityFilter] = useState('all');
    const [assigneeFilter, setAssigneeFilter] = useState('all');
    const [viewMode, setViewMode] = useState<ViewMode>('list');
    const [showModal, setShowModal] = useState(false);
    const [showDetail, setShowDetail] = useState(false);
    const [detailTicket, setDetailTicket] = useState<TicketWithNames | null>(null);
    const [records, setRecords] = useState<TicketRecord[]>([]);
    const [detailMessages, setDetailMessages] = useState<{
        id: string;
        role: string;
        content: string;
        created_at: string
    }[]>([]);
    const [form, setForm] = useState({title: '', description: '', category: '', priority: 'medium'});
    const [actionComment, setActionComment] = useState('');
    const [solutionText, setSolutionText] = useState('');
    const [showAddToKb, setShowAddToKb] = useState(false);
    const [kbForm, setKbForm] = useState({title: '', category_id: '', summary: '', tags: ''});

    useEffect(() => {
        (async () => {
            const emps = await loadEmployees();
            await loadTickets(emps);
            await loadCategories();
        })();
    }, []);


    const loadEmployees = async () => {
        try {
            const data = await api.employees.list();
            setEmployees(data.filter(e => e.status === 'active'));
            return data;   // 返回原始数据
        } catch {
            setEmployees([]);
            return [];
        }
    };

    const loadTickets = async (emps?: Employee[]) => {
        setLoading(true);
        try {
            const data = await api.tickets.list();
            const empMap = Object.fromEntries((emps ?? employees).map(e => [e.id, e.name]));
            const list = data.map(t => ({
                ...t,
                creator_name: t.creator_id ? empMap[t.creator_id] : undefined,
                assignee_name: t.assignee_id ? empMap[t.assignee_id] : undefined,
            }));
            setTickets(list);
        } catch {
            setTickets([]);
        }
        setLoading(false);
    };


    const loadCategories = async () => {
        try {
            const data = await api.kbCategories.list();
            setCategories(data.sort((a, b) => a.sort_order - b.sort_order));
        } catch {
            setCategories([]);
        }
    };

    const filtered = useMemo(() => tickets.filter(t => {
        if (search && !t.title.toLowerCase().includes(search.toLowerCase()) && !t.ticket_no.toLowerCase().includes(search.toLowerCase())) return false;
        if (statusFilter !== 'all' && t.status !== statusFilter) return false;
        if (priorityFilter !== 'all' && t.priority !== priorityFilter) return false;
        if (assigneeFilter !== 'all') {
            if (assigneeFilter === 'unassigned' && t.assignee_id) return false;
            if (assigneeFilter !== 'unassigned' && t.assignee_id !== assigneeFilter) return false;
        }
        return true;
    }), [tickets, search, statusFilter, priorityFilter, assigneeFilter]);

    const stats = useMemo(() => ({
        total: tickets.length,
        pending: tickets.filter(t => t.status === 'pending' || t.status === 'open').length,
        inProgress: tickets.filter(t => t.status === 'in_progress' || t.status === 'assigned').length,
        pendingReview: tickets.filter(t => t.status === 'pending_review' || t.status === 'resolved').length,
        closed: tickets.filter(t => t.status === 'closed').length,
    }), [tickets]);

    // 其他统计数据（分类、绩效、趋势）均基于 tickets 计算，无需额外请求，保持不变。
    // 在 stats 之后添加：

    const avgResolutionTime = useMemo(() => {
        const resolved = tickets.filter(t => t.status === 'closed' && t.resolved_at);
        if (resolved.length === 0) return '-';
        const totalHours = resolved.reduce((sum, t) => {
            const created = new Date(t.created_at).getTime();
            const resolvedAt = new Date(t.resolved_at!).getTime();
            return sum + (resolvedAt - created) / (1000 * 60 * 60);
        }, 0);
        return `${(totalHours / resolved.length).toFixed(1)}h`;
    }, [tickets]);

    const dailyTrend = useMemo(() => {
        const days: { date: string; count: number }[] = [];
        for (let i = 6; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            const dateStr = d.toISOString().slice(0, 10);
            const count = tickets.filter(t => t.created_at.slice(0, 10) === dateStr).length;
            days.push({date: dateStr.slice(5), count});
        }
        return days;
    }, [tickets]);

    const categoryStats = useMemo(() => {
        const map: Record<string, number> = {};
        tickets.forEach(t => {
            const cat = t.category || '未分类';
            map[cat] = (map[cat] || 0) + 1;
        });
        return Object.entries(map).sort((a, b) => b[1] - a[1]).slice(0, 10);
    }, [tickets]);

    const assigneeStats = useMemo(() => {
        const map: Record<string, { name: string; total: number; closed: number }> = {};
        tickets.forEach(t => {
            if (!t.assignee_id) return;
            const name = t.assignee_name ?? '未知';
            if (!map[t.assignee_id]) map[t.assignee_id] = {name, total: 0, closed: 0};
            map[t.assignee_id].total++;
            if (t.status === 'closed') map[t.assignee_id].closed++;
        });
        return Object.values(map).sort((a, b) => b.total - a.total);
    }, [tickets]);
    const createTicket = async () => {
        if (!form.title.trim()) return;
        const ticketNo = `TK${Date.now().toString().slice(-8)}`;
        try {
            await api.tickets.create({
                ticket_no: ticketNo,
                title: form.title,
                description: form.description || null,
                category: form.category || null,
                priority: form.priority,
                status: 'pending',
                source: 'manual',
                creator_id: employee?.id,
            });
            setShowModal(false);
            setForm({title: '', description: '', category: '', priority: 'medium'});
            loadTickets();
        } catch { /* ignore */
        }
    };

    const viewDetail = async (ticket: TicketWithNames) => {
        setDetailTicket(ticket);
        setShowDetail(true);
        setActionComment('');
        setSolutionText(ticket.solution ?? '');

        try {
            const [recs, msgs] = await Promise.all([
                api.tickets.getRecords(ticket.id),
                ticket.conversation_id ? api.tickets.getConversationMessages(ticket.id) : Promise.resolve([]),
            ]);
            setRecords(recs);
            setDetailMessages(msgs as any);
        } catch {
            setRecords([]);
            setDetailMessages([]);
        }
    };

    const assignTicket = async (assigneeId: string) => {
        if (!detailTicket || !employee) return;
        const oldStatus = detailTicket.status;
        const newStatus = assigneeId ? (oldStatus === 'pending' || oldStatus === 'open' ? 'in_progress' : oldStatus) : 'pending';

        try {
            await api.tickets.update(detailTicket.id, {
                assignee_id: assigneeId || null,
                status: newStatus,
            });
            await api.tickets.addRecord(detailTicket.id, {
                action: assigneeId ? '指派运维人员' : '取消指派',
                from_status: oldStatus,
                to_status: newStatus,
                comment: actionComment || null,
                operator_id: employee.id,
            });
            setActionComment('');
            loadTickets();
            viewDetail({...detailTicket, assignee_id: assigneeId, status: newStatus});
        } catch { /* ignore */
        }
    };

    const transferTicket = async (newAssigneeId: string) => {
        if (!detailTicket || !employee || !newAssigneeId) return;
        try {
            await api.tickets.update(detailTicket.id, {
                assignee_id: newAssigneeId,
            });
            const newAssigneeName = employees.find(e => e.id === newAssigneeId)?.name ?? '未知';
            await api.tickets.addRecord(detailTicket.id, {
                action: '转派工单',
                comment: `转派给 ${newAssigneeName}`,
                operator_id: employee.id,
            });
            setActionComment('');
            loadTickets();
            viewDetail({...detailTicket, assignee_id: newAssigneeId});
        } catch { /* ignore */
        }
    };

    const updateStatus = async (newStatus: string) => {
        if (!detailTicket || !employee) return;
        const oldStatus = detailTicket.status;

        const updates: Partial<Ticket> = {status: newStatus};
        if (newStatus === 'closed') {
            updates.resolved_at = new Date().toISOString();
            if (solutionText.trim()) updates.solution = solutionText.trim();
        }

        try {
            await api.tickets.update(detailTicket.id, updates);
            await api.tickets.addRecord(detailTicket.id, {
                action: '状态变更',
                from_status: oldStatus,
                to_status: newStatus,
                comment: actionComment || (newStatus === 'closed' && solutionText ? `解决方案：${solutionText.slice(0, 100)}` : null),
                operator_id: employee.id,
            });
            setActionComment('');
            loadTickets();
            viewDetail({...detailTicket, ...updates});
        } catch { /* ignore */
        }
    };

    const addComment = async () => {
        if (!detailTicket || !employee || !actionComment.trim()) return;
        try {
            await api.tickets.addRecord(detailTicket.id, {
                action: '追加回复',
                comment: actionComment,
                operator_id: employee.id,
            });
            setActionComment('');
            const recs = await api.tickets.getRecords(detailTicket.id);
            setRecords(recs);
        } catch { /* ignore */
        }
    };

    const saveSolutionAndClose = async () => {
        if (!detailTicket || !employee) return;
        if (!solutionText.trim()) {
            alert('请填写解决方案后再关闭工单');
            return;
        }
        const oldStatus = detailTicket.status;
        try {
            await api.tickets.close(detailTicket.id, solutionText.trim());
            await api.tickets.addRecord(detailTicket.id, {
                action: '关闭工单',
                from_status: oldStatus,
                to_status: 'closed',
                comment: `解决方案：${solutionText.slice(0, 200)}`,
                operator_id: employee.id,
            });
            loadTickets();
            viewDetail({...detailTicket, status: 'closed', solution: solutionText.trim()});
        } catch { /* ignore */
        }
    };

    const addToKnowledgeBase = async () => {
        if (!detailTicket || !employee) return;
        if (!kbForm.title.trim() || !kbForm.category_id) {
            alert('请填写标题并选择分类');
            return;
        }
        const tags = kbForm.tags.split(/[,，]/).map(t => t.trim()).filter(Boolean);
        try {
            await api.kbArticles.create({
                title: kbForm.title,
                category_id: kbForm.category_id,
                content: `## 问题描述\n${detailTicket.description ?? detailTicket.title}\n\n## 解决方案\n${solutionText || detailTicket.solution || '见处理记录'}`,
                summary: kbForm.summary || `来自工单 ${detailTicket.ticket_no} 的解决方案`,
                tags,
                status: 'published',
                author_id: employee.id,
            });
            setShowAddToKb(false);
            setKbForm({title: '', category_id: '', summary: '', tags: ''});
            alert('已添加到知识库');
        } catch { /* ignore */
        }
    };

    // 计算统计卡片和图表数据（基于 tickets 本地计算，无需请求）
    const statCards = [
        {label: '全部工单', value: stats.total, color: 'text-white', icon: TicketIcon},
        {label: '待受理', value: stats.pending, color: 'text-amber-400', icon: AlertCircle},
        {label: '处理中', value: stats.inProgress, color: 'text-cyan-400', icon: Clock},
        {label: '待回访', value: stats.pendingReview, color: 'text-blue-400', icon: UserCog},
        {label: '已完结', value: stats.closed, color: 'text-emerald-400', icon: CheckCircle},
    ];

    // 其他统计数据（分类、绩效、趋势）计算逻辑与原代码相同，只是数据来源于 tickets 状态，无需改动。
    return (
        <div className="p-4 lg:p-6 space-y-6">
            <div className="flex items-center justify-between flex-wrap gap-4">
                <div>
                    <h1 className="text-2xl font-bold text-white">工单系统</h1>
                    <p className="text-slate-400 mt-1">问题留痕、流转分配、关联知识库、统计工作量</p>
                </div>
                <div className="flex items-center gap-2">
                    <div className="flex bg-slate-900 border border-slate-800 rounded-xl p-1">
                        <button
                            onClick={() => setViewMode('list')}
                            className={`px-3 py-2 rounded-lg text-sm transition ${viewMode === 'list' ? 'bg-blue-500/15 text-blue-400' : 'text-slate-400 hover:text-white'}`}
                        >
                            工单列表
                        </button>
                        <button
                            onClick={() => setViewMode('stats')}
                            className={`px-3 py-2 rounded-lg text-sm transition ${viewMode === 'stats' ? 'bg-blue-500/15 text-blue-400' : 'text-slate-400 hover:text-white'}`}
                        >
                            统计报表
                        </button>
                    </div>
                    <button
                        onClick={() => setShowModal(true)}
                        className="flex items-center gap-2 px-4 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-xl font-medium transition text-sm"
                    >
                        <Plus className="w-4 h-4"/>
                        创建工单
                    </button>
                </div>
            </div>

            {/* Stats cards */}
            <div className="grid grid-cols-2 lg:grid-cols-5 gap-4">
                {statCards.map((card, i) => (
                    <div key={i} className="bg-slate-900 border border-slate-800 rounded-2xl p-5">
                        <div className="flex items-center justify-between mb-2">
                            <card.icon className={`w-5 h-5 ${card.color}`}/>
                        </div>
                        <div className={`text-3xl font-bold ${card.color}`}>{card.value}</div>
                        <div className="text-sm text-slate-400 mt-1">{card.label}</div>
                    </div>
                ))}
            </div>

            {viewMode === 'stats' ? (
                /* ========== Statistics View ========== */
                <div className="space-y-6">
                    {/* Key metrics */}
                    <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
                        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <div className="flex items-center gap-2 mb-3">
                                <Clock className="w-5 h-5 text-cyan-400"/>
                                <h3 className="text-sm font-medium text-slate-300">平均处理时长</h3>
                            </div>
                            <div className="text-3xl font-bold text-white">{avgResolutionTime}</div>
                            <p className="text-xs text-slate-500 mt-1">已完结工单的平均处理时间</p>
                        </div>
                        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <div className="flex items-center gap-2 mb-3">
                                <TrendingUp className="w-5 h-5 text-blue-400"/>
                                <h3 className="text-sm font-medium text-slate-300">解决率</h3>
                            </div>
                            <div className="text-3xl font-bold text-white">
                                {stats.total > 0 ? `${((stats.closed / stats.total) * 100).toFixed(0)}%` : '-'}
                            </div>
                            <p className="text-xs text-slate-500 mt-1">{stats.closed} / {stats.total} 工单已完结</p>
                        </div>
                        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <div className="flex items-center gap-2 mb-3">
                                <AlertCircle className="w-5 h-5 text-amber-400"/>
                                <h3 className="text-sm font-medium text-slate-300">积压工单</h3>
                            </div>
                            <div className="text-3xl font-bold text-amber-400">{stats.pending + stats.inProgress}</div>
                            <p className="text-xs text-slate-500 mt-1">待受理 + 处理中</p>
                        </div>
                    </div>

                    {/* Daily trend */}
                    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                        <div className="flex items-center gap-2 mb-4">
                            <TrendingUp className="w-5 h-5 text-blue-400"/>
                            <h3 className="text-sm font-medium text-slate-300">每日工单趋势（近7天）</h3>
                        </div>
                        {dailyTrend.length === 0 ? (
                            <div className="flex items-center justify-center h-40 text-slate-500">暂无数据</div>
                        ) : (
                            <ResponsiveContainer width="100%" height={180}>
                                <LineChart data={dailyTrend}>
                                    <CartesianGrid strokeDasharray="3 3" stroke="#1e293b"/>
                                    <XAxis
                                        dataKey="date"
                                        stroke="#64748b"
                                        fontSize={12}
                                        tick={{fill: '#94a3b8'}}
                                    />
                                    <YAxis
                                        stroke="#64748b"
                                        fontSize={12}
                                        tick={{fill: '#94a3b8'}}
                                        allowDecimals={false}
                                    />
                                    <Tooltip
                                        contentStyle={{
                                            background: '#0f172a',
                                            border: '1px solid #1e293b',
                                            borderRadius: '12px',
                                            color: '#fff'
                                        }}
                                    />
                                    <Line
                                        type="monotone"
                                        dataKey="count"
                                        stroke="#3b82f6"
                                        strokeWidth={2.5}
                                        dot={{fill: '#3b82f6', r: 4}}
                                        activeDot={{r: 6}}
                                        name="工单数量"
                                    />
                                </LineChart>
                            </ResponsiveContainer>
                        )}
                    </div>

                    {/* Category distribution + Assignee workload */}
                    <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <div className="flex items-center gap-2 mb-4">
                                <FileText className="w-5 h-5 text-cyan-400"/>
                                <h3 className="text-sm font-medium text-slate-300">故障分类 Top 10</h3>
                            </div>
                            <div className="space-y-3">
                                {categoryStats.length === 0 &&
                                    <div className="text-sm text-slate-500 text-center py-4">暂无数据</div>}
                                {categoryStats.map(([cat, count], i) => (
                                    <div key={i} className="flex items-center gap-3">
                                        <span className="text-sm text-slate-300 w-24 truncate">{cat}</span>
                                        <div className="flex-1 bg-slate-800 rounded-full h-2">
                                            <div className="bg-blue-500 h-2 rounded-full"
                                                 style={{width: `${(count / stats.total) * 100}%`}}/>
                                        </div>
                                        <span className="text-sm text-slate-400 w-8 text-right">{count}</span>
                                    </div>
                                ))}
                            </div>
                        </div>

                        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
                            <div className="flex items-center gap-2 mb-4">
                                <UsersIcon className="w-5 h-5 text-emerald-400"/>
                                <h3 className="text-sm font-medium text-slate-300">运维人员绩效</h3>
                            </div>
                            <div className="space-y-3">
                                {assigneeStats.length === 0 &&
                                    <div className="text-sm text-slate-500 text-center py-4">暂无数据</div>}
                                {assigneeStats.map((a, i) => (
                                    <div key={i} className="flex items-center gap-3">
                                        <div
                                            className="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-white text-xs font-semibold">
                                            {a.name.charAt(0)}
                                        </div>
                                        <span className="text-sm text-slate-300 flex-1">{a.name}</span>
                                        <span className="text-sm text-slate-400">处理 {a.total}</span>
                                        <span className="text-sm text-emerald-400">完结 {a.closed}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            ) : (
                /* ========== List View ========== */
                <>
                    {/* Filters */}
                    <div className="flex flex-wrap gap-3 items-center">
                        <div className="relative flex-1 min-w-[200px]">
                            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500"/>
                            <input
                                value={search}
                                onChange={e => setSearch(e.target.value)}
                                placeholder="搜索工单标题、工单号..."
                                className="w-full bg-slate-900 border border-slate-800 rounded-xl pl-10 pr-4 py-2.5 text-white placeholder-slate-500 focus:border-blue-500 focus:outline-none text-sm"
                            />
                        </div>
                        <select value={statusFilter} onChange={e => setStatusFilter(e.target.value)}
                                className="bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:border-blue-500 focus:outline-none">
                            <option value="all">全部状态</option>
                            <option value="pending">待受理</option>
                            <option value="in_progress">处理中</option>
                            <option value="pending_review">待回访</option>
                            <option value="closed">已完结</option>
                        </select>
                        <select value={priorityFilter} onChange={e => setPriorityFilter(e.target.value)}
                                className="bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:border-blue-500 focus:outline-none">
                            <option value="all">全部优先级</option>
                            {Object.entries(priorityConfig).map(([k, v]) => <option key={k}
                                                                                    value={k}>{v.label}</option>)}
                        </select>
                        <select value={assigneeFilter} onChange={e => setAssigneeFilter(e.target.value)}
                                className="bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-white text-sm focus:border-blue-500 focus:outline-none">
                            <option value="all">全部处理人</option>
                            <option value="unassigned">未分配</option>
                            {employees.map(e => <option key={e.id} value={e.id}>{e.name}</option>)}
                        </select>
                    </div>

                    {/* Table */}
                    <div className="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                        <div className="overflow-auto">
                            <table className="w-full">
                                <thead>
                                <tr className="border-b border-slate-800 bg-slate-900/50">
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">工单号</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">标题</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">分类</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">优先级</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">状态</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">创建人</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">处理人</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">创建时间</th>
                                    <th className="px-4 py-3 text-left text-xs font-medium text-slate-400 uppercase">操作</th>
                                </tr>
                                </thead>
                                <tbody>
                                {loading && <tr>
                                    <td colSpan={9} className="px-4 py-8 text-center text-slate-400">加载中...</td>
                                </tr>}
                                {!loading && filtered.length === 0 && <tr>
                                    <td colSpan={9} className="px-4 py-8 text-center text-slate-400">暂无工单</td>
                                </tr>}
                                {filtered.map(ticket => {
                                    const StatusIcon = statusConfig[ticket.status]?.icon ?? AlertCircle;
                                    return (
                                        <tr key={ticket.id}
                                            className="border-b border-slate-800/50 hover:bg-slate-800/30 transition">
                                            <td className="px-4 py-3 text-sm font-mono text-blue-400">{ticket.ticket_no}</td>
                                            <td className="px-4 py-3 text-sm text-white max-w-[200px] truncate">{ticket.title}</td>
                                            <td className="px-4 py-3 text-sm text-slate-300">{ticket.category ?? '-'}</td>
                                            <td className="px-4 py-3">
                          <span
                              className={`text-xs font-medium ${priorityConfig[ticket.priority]?.color ?? priorityConfig.medium.color}`}>
                            {priorityConfig[ticket.priority]?.label ?? ticket.priority}
                          </span>
                                            </td>
                                            <td className="px-4 py-3">
                          <span
                              className={`text-xs px-2 py-1 rounded-lg inline-flex items-center gap-1 ${statusConfig[ticket.status]?.color ?? statusConfig.pending.color}`}>
                            <StatusIcon className="w-3 h-3"/>
                              {statusConfig[ticket.status]?.label ?? ticket.status}
                          </span>
                                            </td>
                                            <td className="px-4 py-3 text-sm text-slate-300">{ticket.creator_name ?? '-'}</td>
                                            <td className="px-4 py-3 text-sm text-slate-300">{ticket.assignee_name ?? '-'}</td>
                                            <td className="px-4 py-3 text-sm text-slate-500">{new Date(ticket.created_at).toLocaleDateString('zh-CN')}</td>
                                            <td className="px-4 py-3">
                                                <button onClick={() => viewDetail(ticket)}
                                                        className="text-sm text-blue-400 hover:text-blue-300 transition flex items-center gap-1">
                                                    详情 <ChevronRight className="w-3 h-3"/>
                                                </button>
                                            </td>
                                        </tr>
                                    );
                                })}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </>
            )}

            {/* Create modal */}
            {showModal && (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm"
                     onClick={() => setShowModal(false)}>
                    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md"
                         onClick={e => e.stopPropagation()}>
                        <div className="flex items-center justify-between mb-6">
                            <h2 className="text-lg font-bold text-white">创建工单</h2>
                            <button onClick={() => setShowModal(false)} className="text-slate-400 hover:text-white"><X
                                className="w-5 h-5"/></button>
                        </div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">标题 *</label>
                                <input value={form.title} onChange={e => setForm({...form, title: e.target.value})}
                                       className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                       placeholder="工单标题"/>
                            </div>
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">描述</label>
                                <textarea value={form.description}
                                          onChange={e => setForm({...form, description: e.target.value})} rows={4}
                                          className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                          placeholder="详细描述问题，包括设备信息、报错信息、联系人等..."/>
                            </div>
                            <div className="grid grid-cols-2 gap-3">
                                <div>
                                    <label className="block text-sm text-slate-300 mb-1.5">分类</label>
                                    <input value={form.category}
                                           onChange={e => setForm({...form, category: e.target.value})}
                                           className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                           placeholder="故障分类"/>
                                </div>
                                <div>
                                    <label className="block text-sm text-slate-300 mb-1.5">优先级</label>
                                    <select value={form.priority}
                                            onChange={e => setForm({...form, priority: e.target.value})}
                                            className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm">
                                        <option value="low">低</option>
                                        <option value="medium">中</option>
                                        <option value="high">高</option>
                                        <option value="urgent">紧急</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div className="flex gap-3 mt-6">
                            <button onClick={() => setShowModal(false)}
                                    className="flex-1 px-4 py-2.5 bg-slate-800 text-slate-300 rounded-xl hover:bg-slate-700 transition text-sm">取消
                            </button>
                            <button onClick={createTicket}
                                    className="flex-1 px-4 py-2.5 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition text-sm font-medium">创建
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* Detail modal */}
            {showDetail && detailTicket && (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm"
                     onClick={() => setShowDetail(false)}>
                    <div
                        className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl max-h-[92vh] flex flex-col"
                        onClick={e => e.stopPropagation()}>
                        {/* Header */}
                        <div className="flex items-center justify-between p-6 border-b border-slate-800">
                            <div>
                                <span className="text-xs font-mono text-blue-400">{detailTicket.ticket_no}</span>
                                <h2 className="text-lg font-bold text-white mt-1">{detailTicket.title}</h2>
                            </div>
                            <button onClick={() => setShowDetail(false)} className="text-slate-400 hover:text-white"><X
                                className="w-5 h-5"/></button>
                        </div>

                        {/* Body */}
                        <div className="flex-1 overflow-auto p-6 space-y-6">
                            {/* Info grid */}
                            <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
                                <div className="bg-slate-800/30 rounded-xl p-3">
                                    <div className="text-xs text-slate-500 mb-1">优先级</div>
                                    <div
                                        className={`text-sm font-medium ${priorityConfig[detailTicket.priority]?.color ?? priorityConfig.medium.color}`}>
                                        {priorityConfig[detailTicket.priority]?.label ?? detailTicket.priority}
                                    </div>
                                </div>
                                <div className="bg-slate-800/30 rounded-xl p-3">
                                    <div className="text-xs text-slate-500 mb-1">状态</div>
                                    <div
                                        className={`text-sm font-medium ${statusConfig[detailTicket.status]?.color ?? statusConfig.pending.color}`}>
                                        {statusConfig[detailTicket.status]?.label ?? detailTicket.status}
                                    </div>
                                </div>
                                <div className="bg-slate-800/30 rounded-xl p-3">
                                    <div className="text-xs text-slate-500 mb-1">创建人</div>
                                    <div className="text-sm text-white">{detailTicket.creator_name ?? '-'}</div>
                                </div>
                                <div className="bg-slate-800/30 rounded-xl p-3">
                                    <div className="text-xs text-slate-500 mb-1">处理人</div>
                                    <div className="text-sm text-white">{detailTicket.assignee_name ?? '未分配'}</div>
                                </div>
                            </div>

                            {/* Description */}
                            {detailTicket.description && (
                                <div>
                                    <div className="text-xs text-slate-500 mb-2">问题描述</div>
                                    <div
                                        className="text-sm text-slate-300 bg-slate-800/30 rounded-xl p-4 whitespace-pre-wrap">{detailTicket.description}</div>
                                </div>
                            )}

                            {/* Related chat history */}
                            {detailMessages.length > 0 && (
                                <div>
                                    <div className="text-xs text-slate-500 mb-2 flex items-center gap-1.5">
                                        <Link2 className="w-3.5 h-3.5"/>
                                        关联客服对话 ({detailMessages.length} 条消息)
                                    </div>
                                    <div className="bg-slate-800/30 rounded-xl p-4 space-y-2 max-h-48 overflow-auto">
                                        {detailMessages.map(msg => (
                                            <div key={msg.id}
                                                 className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                                                <div className={`text-xs rounded-lg px-3 py-2 max-w-[80%] ${
                                                    msg.role === 'user' ? 'bg-blue-500/20 text-blue-200' : 'bg-slate-700/50 text-slate-300'
                                                }`}>
                                                    <div
                                                        className="text-xs text-slate-500 mb-0.5">{msg.role === 'user' ? '用户' : 'AI客服'}</div>
                                                    {msg.content}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}

                            {/* Solution editor */}
                            <div>
                                <div className="text-xs text-slate-500 mb-2 flex items-center gap-1.5">
                                    <CheckCircle className="w-3.5 h-3.5"/>
                                    处理方案
                                </div>
                                <textarea
                                    value={solutionText}
                                    onChange={e => setSolutionText(e.target.value)}
                                    rows={4}
                                    disabled={detailTicket.status === 'closed'}
                                    className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm disabled:opacity-60"
                                    placeholder="填写处理方案和解决步骤，关闭工单时将保存..."
                                />
                                {detailTicket.status === 'closed' && detailTicket.solution && (
                                    <div className="mt-2 text-xs text-emerald-400 flex items-center gap-1">
                                        <CheckCircle className="w-3 h-3"/>
                                        工单已完结，解决方案已保存
                                    </div>
                                )}
                            </div>

                            {/* Actions */}
                            <div className="space-y-3">
                                {/* Assign / Transfer */}
                                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div>
                                        <label className="block text-sm text-slate-300 mb-1.5">指派处理人</label>
                                        <select
                                            value={detailTicket.assignee_id ?? ''}
                                            onChange={e => assignTicket(e.target.value)}
                                            disabled={detailTicket.status === 'closed'}
                                            className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm disabled:opacity-60"
                                        >
                                            <option value="">未分配</option>
                                            {employees.map(e => <option key={e.id} value={e.id}>{e.name}</option>)}
                                        </select>
                                    </div>
                                    <div>
                                        <label className="block text-sm text-slate-300 mb-1.5">转派给</label>
                                        <select
                                            value=""
                                            onChange={e => {
                                                if (e.target.value) transferTicket(e.target.value);
                                            }}
                                            disabled={detailTicket.status === 'closed' || !detailTicket.assignee_id}
                                            className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm disabled:opacity-60"
                                        >
                                            <option value="">选择转派人员...</option>
                                            {employees.filter(e => e.id !== detailTicket.assignee_id).map(e => <option
                                                key={e.id} value={e.id}>{e.name}</option>)}
                                        </select>
                                    </div>
                                </div>

                                {/* Comment */}
                                <div>
                                    <label className="block text-sm text-slate-300 mb-1.5">操作备注 / 追加回复</label>
                                    <div className="flex gap-2">
                                        <input
                                            value={actionComment}
                                            onChange={e => setActionComment(e.target.value)}
                                            className="flex-1 bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                            placeholder="输入备注或回复内容..."
                                        />
                                        <button
                                            onClick={addComment}
                                            disabled={!actionComment.trim()}
                                            className="px-4 py-2.5 bg-slate-700 text-slate-200 rounded-xl hover:bg-slate-600 transition text-sm disabled:opacity-50 flex items-center gap-1.5"
                                        >
                                            <Send className="w-3.5 h-3.5"/>
                                            追加
                                        </button>
                                    </div>
                                </div>

                                {/* Status buttons */}
                                <div className="flex flex-wrap gap-2">
                                    {statusFlow.map(key => {
                                        const cfg = statusConfig[key];
                                        const isCurrent = detailTicket.status === key || (key === 'pending' && detailTicket.status === 'open') || (key === 'in_progress' && detailTicket.status === 'assigned') || (key === 'pending_review' && detailTicket.status === 'resolved');
                                        return (
                                            <button
                                                key={key}
                                                onClick={() => updateStatus(key)}
                                                disabled={isCurrent || detailTicket.status === 'closed'}
                                                className={`px-3 py-1.5 rounded-lg text-xs font-medium transition disabled:opacity-30 ${cfg.color} hover:opacity-80 flex items-center gap-1`}
                                            >
                                                {key === 'in_progress' && <Play className="w-3 h-3"/>}
                                                {key === 'pending_review' && <UserCog className="w-3 h-3"/>}
                                                {key === 'closed' && <Archive className="w-3 h-3"/>}
                                                {key === 'pending' && <Pause className="w-3 h-3"/>}
                                                设为{cfg.label}
                                            </button>
                                        );
                                    })}
                                </div>

                                {/* Close with solution */}
                                {detailTicket.status !== 'closed' && (
                                    <button
                                        onClick={saveSolutionAndClose}
                                        className="w-full px-4 py-2.5 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-xl hover:bg-emerald-500/25 transition text-sm font-medium flex items-center justify-center gap-2"
                                    >
                                        <CheckCircle className="w-4 h-4"/>
                                        填写解决方案并关闭工单
                                    </button>
                                )}

                                {/* Add to KB */}
                                {detailTicket.status === 'closed' && (
                                    <button
                                        onClick={() => {
                                            setKbForm({
                                                title: `【工单${detailTicket.ticket_no}】${detailTicket.title}`,
                                                category_id: '',
                                                summary: '',
                                                tags: detailTicket.category || ''
                                            });
                                            setShowAddToKb(true);
                                        }}
                                        className="w-full px-4 py-2.5 bg-blue-500/15 text-blue-400 border border-blue-500/30 rounded-xl hover:bg-blue-500/25 transition text-sm font-medium flex items-center justify-center gap-2"
                                    >
                                        <BookPlus className="w-4 h-4"/>
                                        将解决方案添加到知识库
                                    </button>
                                )}
                            </div>

                            {/* Records timeline */}
                            <div>
                                <div className="text-sm text-slate-300 mb-3 flex items-center gap-2">
                                    <MessageSquare className="w-4 h-4"/>
                                    处理记录 ({records.length})
                                </div>
                                <div className="space-y-2">
                                    {records.length === 0 &&
                                        <div className="text-xs text-slate-500 text-center py-4">暂无处理记录</div>}
                                    {records.map(rec => (
                                        <div key={rec.id}
                                             className="bg-slate-800/30 rounded-xl p-3 flex items-start gap-3">
                                            <div className="w-2 h-2 rounded-full bg-blue-400 mt-1.5 flex-shrink-0"/>
                                            <div className="flex-1">
                                                <div className="text-sm text-white">{rec.action}</div>
                                                <div className="text-xs text-slate-500 mt-0.5">
                                                    {rec.from_status && `从 ${statusConfig[rec.from_status]?.label ?? rec.from_status} → `}
                                                    {rec.to_status && `到 ${statusConfig[rec.to_status]?.label ?? rec.to_status}`}
                                                </div>
                                                {rec.comment &&
                                                    <div className="text-xs text-slate-400 mt-1">{rec.comment}</div>}
                                                <div
                                                    className="text-xs text-slate-600 mt-1">{new Date(rec.created_at).toLocaleString('zh-CN')}</div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            )}

            {/* Add to KB modal */}
            {showAddToKb && (
                <div className="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm"
                     onClick={() => setShowAddToKb(false)}>
                    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md"
                         onClick={e => e.stopPropagation()}>
                        <div className="flex items-center justify-between mb-6">
                            <h2 className="text-lg font-bold text-white">添加到知识库</h2>
                            <button onClick={() => setShowAddToKb(false)} className="text-slate-400 hover:text-white"><X
                                className="w-5 h-5"/></button>
                        </div>
                        <div className="space-y-4">
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">标题 *</label>
                                <input value={kbForm.title}
                                       onChange={e => setKbForm({...kbForm, title: e.target.value})}
                                       className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"/>
                            </div>
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">分类 *</label>
                                <select value={kbForm.category_id}
                                        onChange={e => setKbForm({...kbForm, category_id: e.target.value})}
                                        className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm">
                                    <option value="">请选择分类</option>
                                    {categories.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
                                </select>
                            </div>
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">摘要</label>
                                <input value={kbForm.summary}
                                       onChange={e => setKbForm({...kbForm, summary: e.target.value})}
                                       className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                       placeholder="一句话描述"/>
                            </div>
                            <div>
                                <label className="block text-sm text-slate-300 mb-1.5">标签（逗号分隔）</label>
                                <input value={kbForm.tags} onChange={e => setKbForm({...kbForm, tags: e.target.value})}
                                       className="w-full bg-slate-800/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none text-sm"
                                       placeholder="VPN, 网络, 连接失败"/>
                            </div>
                        </div>
                        <div className="flex gap-3 mt-6">
                            <button onClick={() => setShowAddToKb(false)}
                                    className="flex-1 px-4 py-2.5 bg-slate-800 text-slate-300 rounded-xl hover:bg-slate-700 transition text-sm">取消
                            </button>
                            <button onClick={addToKnowledgeBase}
                                    className="flex-1 px-4 py-2.5 bg-blue-500 text-white rounded-xl hover:bg-blue-600 transition text-sm font-medium">添加
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}



